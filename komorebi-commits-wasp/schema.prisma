datasource db {
  provider = "postgresql"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

model Share {
  id            String   @id @default(uuid())
  handle        String // github username, lowercased
  action        String // "link" | "png" | "gif" — most recent action for this combo
  prefsKey      String // canonical serialization of prefs, e.g. "0.12|0.10|0.50|0.70|2"
  prefs         Json // { fringe, breeze, shade, dapple, grain }
  contributions Json // snapshot at click time: [{ date, count, level }]
  total         Int
  streak        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([handle, prefsKey])
  @@index([updatedAt])
}
